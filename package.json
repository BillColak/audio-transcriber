{
  "name": "audio-transcriber",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/prepare-resources.mjs",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "dev:server": "cargo run --manifest-path src-tauri/Cargo.toml --bin serve"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "latest",
    "ffmpeg-static": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "dotenv": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
